            </div>
        </div>
    </header>

    <!-- MOBILE NAVIGATION DRAWER -->
    <div id="mobileDrawer" class="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300">
        <div class="fixed top-0 left-0 w-4/5 max-w-sm h-full bg-brand-bg p-6 shadow-2xl flex flex-col justify-between transform -translate-x-full transition-transform duration-300" id="mobileDrawerContent">
            <div>
                <div class="flex justify-between items-center pb-6 border-b border-brand-green/10">
                    <span class="font-serif text-2xl font-bold tracking-[0.2em] text-brand-dark">AROMABAR</span>
                    <button id="mobileMenuCloseBtn" class="text-brand-dark text-2xl hover:text-brand-green">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
                <nav class="mt-8 flex flex-col space-y-5 text-sm uppercase tracking-wider font-medium">
                    <a href="#koleksiyon" class="mobile-nav-link text-brand-dark hover:text-brand-green">Koleksiyon</a>
                    <a href="#koku-testi" class="mobile-nav-link text-brand-green font-semibold flex items-center gap-2">
                        <i class="fa-solid fa-wand-magic-sparkles text-brand-gold"></i> Parfüm Testi
                    </a>
                    <a href="#notalar" class="mobile-nav-link text-brand-dark hover:text-brand-green">Notalar Keşfi</a>
                    <a href="#hikayemiz" class="mobile-nav-link text-brand-dark hover:text-brand-green">Hakkımızda</a>
                    <a href="#iletisim" class="mobile-nav-link text-brand-dark hover:text-brand-green">İletişim</a>
                </nav>
            </div>
            <div class="pt-6 border-t border-brand-green/10">
                <div class="flex items-center space-x-4 text-brand-dark text-lg">
                    <a href="#" class="hover:text-brand-green"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#" class="hover:text-brand-green"><i class="fa-brands fa-pinterest-p"></i></a>
                    <a href="#" class="hover:text-brand-green"><i class="fa-brands fa-youtube"></i></a>
                </div>
            </div>
        </div>
    </div>

    <!-- HERO SECTION -->
    <section class="relative min-h-[85vh] flex items-center justify-center bg-gradient-to-br from-brand-bg via-brand-bg-alt to-[#ECE7DB] overflow-hidden py-16">
        <!-- Subtle Organic Background Shapes -->
        <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-brand-green/10 blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-96 h-96 rounded-full bg-brand-gold/15 blur-3xl pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 grid lg:grid-cols-12 gap-12 items-center">
            <!-- Hero Text Content -->
            <div class="lg:col-span-7 text-center lg:text-left space-y-6">
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-green/10 border border-brand-green/20 text-brand-green text-xs font-semibold uppercase tracking-widest">
                    <i class="fa-solid fa-crown text-brand-gold"></i> Niş Esans Sanatı
                </div>
                <h1 class="font-serif text-4xl sm:text-6xl lg:text-7xl font-light text-brand-dark leading-tight">
                    Doğanın Derin Esansları, <br>
                    <span class="italic font-normal text-brand-green">Lüksün Dokunuşu</span>
                </h1>
                <p class="text-brand-muted text-base sm:text-lg max-w-xl mx-auto lg:mx-0 font-light leading-relaxed">
                    Aromabar, nadir botanik özleri ve sanatsal distilasyon tekniklerini bir araya getirerek teninizde unutulmaz bir imza bırakan benzersiz parfüm kreasyonları sunar.
                </p>
                <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
                    <a href="#koleksiyon" class="w-full sm:w-auto px-8 py-4 bg-brand-green text-white font-medium text-xs uppercase tracking-widest rounded-full shadow-lg hover:bg-brand-green-dark transition-all duration-300 transform hover:-translate-y-0.5 text-center">
                        Koleksiyonu İncele
                    </a>
                    <a href="#koku-testi" class="w-full sm:w-auto px-8 py-4 bg-transparent border border-brand-gold text-brand-dark hover:bg-brand-gold/10 font-medium text-xs uppercase tracking-widest rounded-full transition-all duration-300 flex items-center justify-center gap-2 text-center">
                        <i class="fa-solid fa-wand-magic-sparkles text-brand-gold"></i> Koku Testini Çöz
                    </a>
                </div>
            </div>

            <!-- Hero Visual Bottle Art -->
            <div class="lg:col-span-5 flex justify-center relative">
                <div class="relative w-72 h-96 sm:w-80 sm:h-[420px] rounded-t-full bg-gradient-to-b from-brand-card to-brand-bg border border-brand-gold/30 p-6 flex flex-col items-center justify-between shadow-2xl">
                    <!-- Gold Floating Badge -->
                    <div class="absolute -top-4 -right-4 bg-brand-dark text-brand-gold p-4 rounded-full border border-brand-gold/40 shadow-xl text-center transform rotate-12">
                        <span class="block font-serif text-lg leading-none">100%</span>
                        <span class="text-[9px] uppercase tracking-tighter">Saf Esans</span>
                    </div>

                    <!-- SVG Bottle Visualization -->
                    <div class="w-full h-full flex flex-col items-center justify-center my-auto">
                        <!-- Bottle Cap -->
                        <div class="w-16 h-10 bg-gradient-to-r from-brand-gold via-brand-gold-light to-brand-gold-dark rounded-t-md shadow-md border-b border-black/20"></div>
                        <div class="w-8 h-4 bg-brand-dark/20"></div>
                        <!-- Bottle Body -->
                        <div class="w-48 h-60 rounded-3xl bg-gradient-to-b from-brand-green/80 to-brand-green-dark/95 p-4 flex flex-col items-center justify-between border-2 border-brand-gold/40 shadow-2xl relative overflow-hidden">
                            <!-- Inner Liquid Accent -->
                            <div class="absolute inset-x-0 bottom-0 h-3/4 bg-brand-green opacity-90 rounded-b-2xl"></div>
                            <div class="relative z-10 w-full text-center mt-6">
                                <span class="block font-serif text-xs tracking-[0.3em] text-brand-gold uppercase">Aromabar</span>
                                <span class="block font-serif text-xl text-white font-semibold tracking-wider mt-1">L'SANG</span>
                                <span class="block text-[8px] text-brand-gold-light uppercase tracking-widest mt-0.5">Extrait de Parfum</span>
                            </div>
                            <div class="relative z-10 w-8 h-8 rounded-full border border-brand-gold/50 flex items-center justify-center text-brand-gold text-xs">
                                ✦
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- INTERACTIVE SCENT MATCHER (KOKU TESTİ) -->
    <section id="koku-testi" class="py-20 bg-brand-card border-y border-brand-green/10 relative">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center space-y-3 mb-10">
                <span class="text-xs uppercase tracking-[0.25em] text-brand-gold font-semibold">Kişiselleştirilmiş Deneyim</span>
                <h2 class="font-serif text-3xl sm:text-4xl text-brand-dark font-normal">İmza Kokunuzu Bulun</h2>
                <p class="text-brand-muted text-sm max-w-lg mx-auto font-light">
                    3 hızlı soruda ruh halinize, yaşam tarzınıza ve tercihlerinize en uygun niş parfümü keşfedin.
                </p>
            </div>

            <!-- Quiz Box -->
            <div class="bg-brand-bg rounded-2xl p-6 sm:p-10 border border-brand-gold/20 shadow-xl relative min-h-[380px] flex flex-col justify-between">
                
                <!-- Progress Indicators -->
                <div class="flex items-center justify-center space-x-3 mb-8" id="quizProgress">
                    <div class="quiz-step-dot w-8 h-2 rounded-full bg-brand-green transition-all duration-300"></div>
                    <div class="quiz-step-dot w-8 h-2 rounded-full bg-brand-green/20 transition-all duration-300"></div>
                    <div class="quiz-step-dot w-8 h-2 rounded-full bg-brand-green/20 transition-all duration-300"></div>
                </div>

                <!-- Step 1 -->
                <div class="quiz-step flex-1 flex flex-col justify-center" id="quizStep1">
                    <h3 class="font-serif text-xl sm:text-2xl text-center text-brand-dark mb-6">Hangi hissi veya koku karakterini tercih edersiniz?</h3>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <button onclick="selectQuizOption(1, 'ferah')" class="quiz-option p-5 bg-white border border-brand-green/10 hover:border-brand-gold rounded-xl text-center hover:shadow-md transition-all group">
                            <i class="fa-solid fa-wind text-2xl text-brand-green group-hover:scale-110 transition-transform mb-2"></i>
                            <div class="font-medium text-sm text-brand-dark">Ferah & Canlandırıcı</div>
                            <div class="text-xs text-brand-muted font-light mt-1">Narenciye, Deniz & Yeşil Notalar</div>
                        </button>
                        <button onclick="selectQuizOption(1, 'odunsu')" class="quiz-option p-5 bg-white border border-brand-green/10 hover:border-brand-gold rounded-xl text-center hover:shadow-md transition-all group">
                            <i class="fa-solid fa-tree text-2xl text-brand-green group-hover:scale-110 transition-transform mb-2"></i>
                            <div class="font-medium text-sm text-brand-dark">Odunsu & Karizmatik</div>
                            <div class="text-xs text-brand-muted font-light mt-1">Sandal Ağacı, Sedir & Vetiver</div>
                        </button>
                        <button onclick="selectQuizOption(1, 'oryantal')" class="quiz-option p-5 bg-white border border-brand-green/10 hover:border-brand-gold rounded-xl text-center hover:shadow-md transition-all group">
                            <i class="fa-solid fa-fire text-2xl text-brand-green group-hover:scale-110 transition-transform mb-2"></i>
                            <div class="font-medium text-sm text-brand-dark">Oryantal & Sıcak</div>
                            <div class="text-xs text-brand-muted font-light mt-1">Amber, Vanilya & Nadir Baharatlar</div>
                        </button>
                    </div>
                </div>

                <!-- Step 2 -->
                <div class="quiz-step hidden flex-1 flex flex-col justify-center" id="quizStep2">
                    <h3 class="font-serif text-xl sm:text-2xl text-center text-brand-dark mb-6">Parfümünüzü en çok nerede kullanmayı planlıyorsunuz?</h3>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <button onclick="selectQuizOption(2, 'gunduz')" class="quiz-option p-5 bg-white border border-brand-green/10 hover:border-brand-gold rounded-xl text-center hover:shadow-md transition-all group">
                            <i class="fa-solid fa-sun text-2xl text-brand-gold group-hover:scale-110 transition-transform mb-2"></i>
                            <div class="font-medium text-sm text-brand-dark">Günlük & Ofis</div>
                            <div class="text-xs text-brand-muted font-light mt-1">Zarif, Hafif & Yormayan Etki</div>
                        </button>
                        <button onclick="selectQuizOption(2, 'gece')" class="quiz-option p-5 bg-white border border-brand-green/10 hover:border-brand-gold rounded-xl text-center hover:shadow-md transition-all group">
                            <i class="fa-solid fa-moon text-2xl text-brand-green group-hover:scale-110 transition-transform mb-2"></i>
                            <div class="font-medium text-sm text-brand-dark">Gece & Şık Davetler</div>
                            <div class="text-xs text-brand-muted font-light mt-1">Yoğun, Etkileyici & Akılda Kalıcı</div>
                        </button>
                        <button onclick="selectQuizOption(2, 'ozel')" class="quiz-option p-5 bg-white border border-brand-green/10 hover:border-brand-gold rounded-xl text-center hover:shadow-md transition-all group">
                            <i class="fa-solid fa-gem text-2xl text-brand-gold group-hover:scale-110 transition-transform mb-2"></i>
                            <div class="font-medium text-sm text-brand-dark">İmza Parfüm</div>
                            <div class="text-xs text-brand-muted font-light mt-1">Her Mevsim & Her An Fark Yaratan</div>
                        </button>
                    </div>
                </div>

                <!-- Step 3 -->
                <div class="quiz-step hidden flex-1 flex flex-col justify-center" id="quizStep3">
                    <h3 class="font-serif text-xl sm:text-2xl text-center text-brand-dark mb-6">Hangi mevsim ruhunu yansıtıyorsunuz?</h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-lg mx-auto w-full">
                        <button onclick="selectQuizOption(3, 'yaz')" class="quiz-option p-5 bg-white border border-brand-green/10 hover:border-brand-gold rounded-xl text-center hover:shadow-md transition-all group">
                            <i class="fa-solid fa-cloud-sun text-2xl text-brand-gold group-hover:scale-110 transition-transform mb-2"></i>
                            <div class="font-medium text-sm text-brand-dark">İlkbahar - Yaz</div>
                            <div class="text-xs text-brand-muted font-light mt-1">Güneşli, Ferah & Aydınlık</div>
                        </button>
                        <button onclick="selectQuizOption(3, 'kis')" class="quiz-option p-5 bg-white border border-brand-green/10 hover:border-brand-gold rounded-xl text-center hover:shadow-md transition-all group">
                            <i class="fa-solid fa-snowflake text-2xl text-brand-green group-hover:scale-110 transition-transform mb-2"></i>
                            <div class="font-medium text-sm text-brand-dark">Sonbahar - Kış</div>
                            <div class="text-xs text-brand-muted font-light mt-1">Derin, Sıcak & Zengin</div>
                        </button>
                    </div>
                </div>

                <!-- Quiz Result Screen -->
                <div class="quiz-step hidden flex-1 flex flex-col items-center justify-center text-center" id="quizResult">
                    <div class="inline-flex items-center gap-1.5 text-xs uppercase tracking-widest text-brand-gold font-semibold mb-2">
                        <i class="fa-solid fa-circle-check"></i> %98 Uyumlu Eşleşmeniz
                    </div>
                    <h3 class="font-serif text-2xl sm:text-3xl text-brand-dark font-bold" id="resultPerfumeName">Velvet Amber & Oudh</h3>
                    <p class="text-brand-muted text-xs sm:text-sm max-w-md mt-2 mb-6" id="resultPerfumeDesc">
                        Seçimlerinize göre derin amber notaları ve asil ud ağacı dokunuşları teniniz için ideal dengedir.
                    </p>
                    <div class="flex items-center gap-4">
                        <button id="resultAddToCartBtn" class="px-6 py-3 bg-brand-green text-white text-xs uppercase tracking-widest rounded-full hover:bg-brand-green-dark transition-all">
                            Sepete Ekle - <span id="resultPerfumePrice">3.450 TL</span>
                        </button>
                        <button onclick="resetQuiz()" class="px-4 py-3 text-xs uppercase tracking-widest text-brand-muted hover:text-brand-dark underline">
                            Tekrar Dene
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- FEATURED COLLECTION (ÜRÜN KATALOĞU) -->
    <section id="koleksiyon" class="py-20 bg-brand-bg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
                <div>
                    <span class="text-xs uppercase tracking-[0.25em] text-brand-gold font-semibold">Özel Seçki</span>
                    <h2 class="font-serif text-3xl sm:text-5xl text-brand-dark font-normal">Aromabar Koleksiyonu</h2>
                </div>

                <!-- Category Filters -->
                <div class="flex flex-wrap gap-2 mt-6 md:mt-0 text-xs uppercase tracking-wider">
                    <button onclick="filterProducts('all')" class="filter-btn active px-4 py-2 rounded-full border border-brand-green bg-brand-green text-white transition-all">Tümü</button>
                    <button onclick="filterProducts('nis')" class="filter-btn px-4 py-2 rounded-full border border-brand-green/20 text-brand-dark hover:border-brand-green transition-all">Niş Parfümler</button>
                    <button onclick="filterProducts('unisex')" class="filter-btn px-4 py-2 rounded-full border border-brand-green/20 text-brand-dark hover:border-brand-green transition-all">Unisex</button>
                    <button onclick="filterProducts('kadin')" class="filter-btn px-4 py-2 rounded-full border border-brand-green/20 text-brand-dark hover:border-brand-green transition-all">Kadın</button>
                    <button onclick="filterProducts('erkek')" class="filter-btn px-4 py-2 rounded-full border border-brand-green/20 text-brand-dark hover:border-brand-green transition-all">Erkek</button>
                </div>
            </div>

            <!-- Product Cards Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8" id="productGrid">
                <!-- Products dynamically rendered via JavaScript -->
            </div>
        </div>
    </section>

    <!-- INTERACTIVE SCENT ACCORD EXPLORER (NOTALAR KEŞFİ) -->
    <section id="notalar" class="py-20 bg-brand-bg-alt border-y border-brand-green/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center space-y-3 mb-12">
                <span class="text-xs uppercase tracking-[0.25em] text-brand-gold font-semibold">Koku Piramidi</span>
                <h2 class="font-serif text-3xl sm:text-5xl text-brand-dark font-normal">Notaların Mimarisi</h2>
                <p class="text-brand-muted text-sm max-w-xl mx-auto font-light">
                    Bir parfümün zamanla tene yerleşme serüveni. Her nota katmanının ardındaki botanik harikaları keşfedin.
                </p>
            </div>

            <!-- Accord Tabs -->
            <div class="flex justify-center mb-8 border-b border-brand-green/10">
                <div class="inline-flex space-x-8">
                    <button onclick="switchAccordTab('top')" id="accordTab-top" class="accord-tab-btn pb-4 font-serif text-xl text-brand-green border-b-2 border-brand-green font-semibold transition-all">
