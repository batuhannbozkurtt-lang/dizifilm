                { name: "Sıcak Amber & Vanilya", desc: "Ten ısısıyla birleştikçe daha da çekici hale gelen, afrodizyak etkili sıcak balzamık bitiş.", icon: "fa-fire" }
            ]
        };

        // --- STATE MANAGEMENT ---
        let cart = [];
        let quizAnswers = { feel: '', area: '', season: '' };
        let currentQuizStep = 1;

        // --- DOM INITIALIZATION ---
        document.addEventListener('DOMContentLoaded', () => {
            renderProducts(products);
            switchAccordTab('top');
            setupEventListeners();
        });

        // --- RENDER PRODUCTS ---
        function renderProducts(items) {
            const container = document.getElementById('productGrid');
            if (!container) return;

            if (items.length === 0) {
                container.innerHTML = `<div class="col-span-full text-center py-12 text-brand-muted">Aradığınız kriterlere uygun ürün bulunamadı.</div>`;
                return;
            }

            container.innerHTML = items.map(product => `
                <div class="bg-white rounded-3xl p-6 border border-brand-green/10 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
                    <div>
                        <!-- Product SVG Bottle Visual -->
                        <div class="w-full h-64 rounded-2xl bg-gradient-to-br ${product.imageBg} p-4 flex flex-col items-center justify-center relative overflow-hidden mb-6 group-hover:scale-[1.02] transition-transform duration-300">
                            <span class="absolute top-3 left-3 bg-white/20 backdrop-blur-md text-white text-[10px] uppercase tracking-widest px-2.5 py-1 rounded-full font-medium border border-white/20">
                                ${product.gender}
                            </span>
                            
                            <!-- Bottle Illustration -->
                            <div class="w-24 h-40 flex flex-col items-center drop-shadow-2xl">
                                <div class="w-8 h-6 bg-gradient-to-r from-brand-gold via-brand-gold-light to-brand-gold-dark rounded-t shadow-md"></div>
                                <div class="w-4 h-2 bg-black/30"></div>
                                <div class="w-20 h-32 bg-white/10 backdrop-blur-md rounded-2xl border border-white/40 flex flex-col items-center justify-center p-2 text-center">
                                    <span class="font-serif text-[10px] text-brand-gold tracking-widest uppercase">Aromabar</span>
                                    <span class="font-serif text-xs text-white font-semibold tracking-wider mt-0.5 line-clamp-1">${product.name}</span>
                                </div>
                            </div>

                            <button onclick="openQuickView('${product.id}')" class="absolute bottom-3 bg-white/90 hover:bg-white text-brand-dark text-xs uppercase tracking-widest px-4 py-2 rounded-full font-medium shadow transition-all opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0">
                                Hızlı Bakış
                            </button>
                        </div>

                        <!-- Product Title & Info -->
                        <span class="text-[10px] uppercase tracking-widest text-brand-gold font-semibold">${product.volume}</span>
                        <h3 class="font-serif text-2xl text-brand-dark font-medium mt-1 mb-2 group-hover:text-brand-green transition-colors">${product.name}</h3>
                        
                        <!-- Notes Badges -->
                        <div class="flex flex-wrap gap-1.5 my-3">
                            ${product.topNotes.slice(0, 2).map(note => `<span class="bg-brand-bg-alt text-brand-dark/70 text-[10px] px-2 py-0.5 rounded-md font-light">${note}</span>`).join('')}
                            <span class="bg-brand-bg-alt text-brand-dark/70 text-[10px] px-2 py-0.5 rounded-md font-light">+${product.heartNotes[0]}</span>
                        </div>
                    </div>

                    <div class="pt-4 border-t border-brand-green/10 flex items-center justify-between mt-4">
                        <div class="font-serif text-xl font-bold text-brand-dark">${product.price.toLocaleString('tr-TR')} TL</div>
                        <button onclick="addToCart('${product.id}')" class="px-4 py-2.5 bg-brand-green text-white text-xs uppercase tracking-widest rounded-full hover:bg-brand-green-dark transition-colors flex items-center gap-2">
                            <i class="fa-solid fa-plus"></i> Sepete Ekle
                        </button>
                    </div>
                </div>
            `).join('');
        }

        // --- FILTER PRODUCTS BY CATEGORY ---
        function filterProducts(category) {
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('bg-brand-green', 'text-white', 'active');
                btn.classList.add('text-brand-dark');
            });
            event.target.classList.add('bg-brand-green', 'text-white', 'active');
            event.target.classList.remove('text-brand-dark');

            if (category === 'all') {
                renderProducts(products);
            } else {
                const filtered = products.filter(p => p.category === category || p.gender === category);
                renderProducts(filtered);
            }
        }

        // --- ACCORD TAB EXPLORER SWITCHING ---
        function switchAccordTab(tabKey) {
            document.querySelectorAll('.accord-tab-btn').forEach(btn => {
                btn.classList.remove('text-brand-green', 'border-brand-green', 'font-semibold');
                btn.classList.add('text-brand-dark/60', 'border-transparent');
            });

            const activeBtn = document.getElementById(`accordTab-${tabKey}`);
            if (activeBtn) {
                activeBtn.classList.add('text-brand-green', 'border-brand-green', 'font-semibold');
                activeBtn.classList.remove('text-brand-dark/60', 'border-transparent');
            }

            const container = document.getElementById('accordContent');
            if (!container) return;

            container.innerHTML = accordsData[tabKey].map(item => `
                <div class="bg-white p-6 rounded-2xl border border-brand-green/10 shadow-sm hover:border-brand-gold transition-all">
                    <div class="w-12 h-12 rounded-xl bg-brand-bg-alt flex items-center justify-center text-brand-green text-xl mb-4">
                        <i class="fa-solid ${item.icon}"></i>
                    </div>
                    <h4 class="font-serif text-xl text-brand-dark font-medium mb-2">${item.name}</h4>
                    <p class="text-brand-muted text-xs font-light leading-relaxed">${item.desc}</p>
                </div>
            `).join('');
        }

        // --- QUIZ LOGIC ---
        function selectQuizOption(step, answer) {
            if (step === 1) quizAnswers.feel = answer;
            if (step === 2) quizAnswers.area = answer;
            if (step === 3) quizAnswers.season = answer;

            if (step < 3) {
                document.getElementById(`quizStep${step}`).classList.add('hidden');
                document.getElementById(`quizStep${step + 1}`).classList.remove('hidden');
                updateQuizDots(step + 1);
            } else {
                showQuizResult();
            }
        }

        function updateQuizDots(activeStep) {
            const dots = document.querySelectorAll('.quiz-step-dot');
            dots.forEach((dot, index) => {
                if (index < activeStep) {
                    dot.classList.add('bg-brand-green');
                    dot.classList.remove('bg-brand-green/20');
                } else {
                    dot.classList.remove('bg-brand-green');
                    dot.classList.add('bg-brand-green/20');
                }
            });
        }

        function showQuizResult() {
            document.getElementById('quizStep3').classList.add('hidden');
            document.getElementById('quizProgress').classList.add('hidden');
            
            // Find matched product based on quiz answers or fallback
            let matched = products.find(p => p.feel === quizAnswers.feel) || products[0];

            document.getElementById('resultPerfumeName').textContent = matched.name;
            document.getElementById('resultPerfumeDesc').textContent = matched.description;
            document.getElementById('resultPerfumePrice').textContent = `${matched.price.toLocaleString('tr-TR')} TL`;
            
            const addBtn = document.getElementById('resultAddToCartBtn');
            addBtn.onclick = () => addToCart(matched.id);

            document.getElementById('quizResult').classList.remove('hidden');
        }

        function resetQuiz() {
            quizAnswers = { feel: '', area: '', season: '' };
            document.getElementById('quizResult').classList.add('hidden');
            document.getElementById('quizStep1').classList.remove('hidden');
            document.getElementById('quizProgress').classList.remove('hidden');
            updateQuizDots(1);
        }

        // --- CART LOGIC ---
        function addToCart(productId) {
            const product = products.find(p => p.id === productId);
            if (!product) return;

            const existingIndex = cart.findIndex(item => item.id === productId);
            if (existingIndex > -1) {
                cart[existingIndex].quantity += 1;
            } else {
                cart.push({ ...product, quantity: 1 });
            }

            updateCartUI();
            showToast(`"${product.name}" sepete eklendi.`);
            openCart();
        }

        function updateQuantity(productId, delta) {
            const index = cart.findIndex(item => item.id === productId);
            if (index > -1) {
                cart[index].quantity += delta;
                if (cart[index].quantity <= 0) {
                    cart.splice(index, 1);
                }
            }
            updateCartUI();
        }

        function updateCartUI() {
            const badge = document.getElementById('cartBadge');
            const container = document.getElementById('cartItemsContainer');
            const subtotalEl = document.getElementById('cartSubtotal');
            const totalEl = document.getElementById('cartTotal');
            const shippingBar = document.getElementById('shippingBar');
            const shippingDiff = document.getElementById('shippingDiff');

            const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);

            // Update badge
            badge.textContent = totalItems;
            if (totalItems > 0) {
                badge.classList.remove('scale-0');
                badge.classList.add('scale-100');
            } else {
                badge.classList.remove('scale-100');
                badge.classList.add('scale-0');
            }

            // Update Free Shipping Progress (Threshold: 2000 TL)
            const threshold = 2000;
            if (totalPrice >= threshold) {
                shippingBar.style.width = '100%';
                shippingDiff.textContent = 'Ücretsiz Kargo Kazanıldı!';
                shippingDiff.classList.add('text-brand-green');
            } else {
                const perc = (totalPrice / threshold) * 100;
                shippingBar.style.width = `${perc}%`;
                shippingDiff.textContent = `${(threshold - totalPrice).toLocaleString('tr-TR')} TL Kaldı`;
                shippingDiff.classList.remove('text-brand-green');
            }

            // Render Cart Items
            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12 text-brand-muted space-y-3">
                        <i class="fa-solid fa-bag-shopping text-4xl text-brand-green/30"></i>
                        <p class="text-xs">Sepetinizde henüz ürün bulunmuyor.</p>
                    </div>
                `;
            } else {
                container.innerHTML = cart.map(item => `
                    <div class="flex items-center justify-between p-3 bg-white rounded-2xl border border-brand-green/10">
                        <div class="flex items-center gap-3">
                            <div class="w-12 h-12 rounded-xl bg-gradient-to-br ${item.imageBg} flex items-center justify-center text-white text-xs font-serif font-bold shrink-0">
                                AB
                            </div>
                            <div>
                                <h4 class="font-serif font-medium text-sm text-brand-dark">${item.name}</h4>
                                <span class="text-[10px] text-brand-muted block">${item.price.toLocaleString('tr-TR')} TL</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="updateQuantity('${item.id}', -1)" class="w-6 h-6 rounded-full bg-brand-bg-alt flex items-center justify-center text-xs text-brand-dark hover:bg-brand-green hover:text-white transition-colors">-</button>
                            <span class="text-xs font-semibold px-1">${item.quantity}</span>
                            <button onclick="updateQuantity('${item.id}', 1)" class="w-6 h-6 rounded-full bg-brand-bg-alt flex items-center justify-center text-xs text-brand-dark hover:bg-brand-green hover:text-white transition-colors">+</button>
                        </div>
                    </div>
                `).join('');
            }

            subtotalEl.textContent = `${totalPrice.toLocaleString('tr-TR')} TL`;
            totalEl.textContent = `${totalPrice.toLocaleString('tr-TR')} TL`;
        }

        // --- QUICK VIEW MODAL ---
        function openQuickView(productId) {
            const product = products.find(p => p.id === productId);
            if (!product) return;

            const modalBody = document.getElementById('quickViewModalBody');
            modalBody.innerHTML = `
                <div class="w-full h-64 sm:h-80 rounded-2xl bg-gradient-to-br ${product.imageBg} p-6 flex flex-col items-center justify-center relative shadow-inner">
                    <div class="w-24 h-40 flex flex-col items-center drop-shadow-2xl">
                        <div class="w-8 h-6 bg-gradient-to-r from-brand-gold via-brand-gold-light to-brand-gold-dark rounded-t shadow-md"></div>
                        <div class="w-4 h-2 bg-black/30"></div>
                        <div class="w-20 h-32 bg-white/10 backdrop-blur-md rounded-2xl border border-white/40 flex flex-col items-center justify-center p-2 text-center">
                            <span class="font-serif text-[10px] text-brand-gold tracking-widest uppercase">Aromabar</span>
                            <span class="font-serif text-xs text-white font-semibold tracking-wider mt-0.5 line-clamp-2">${product.name}</span>
                        </div>
                    </div>
                </div>
                <div class="space-y-4">
                    <span class="text-xs uppercase tracking-widest text-brand-gold font-semibold">${product.volume}</span>
                    <h3 class="font-serif text-3xl text-brand-dark font-medium">${product.name}</h3>
                    <p class="text-xs text-brand-muted leading-relaxed font-light">${product.description}</p>
                    
                    <div class="space-y-2 pt-2">
                        <div class="text-xs"><strong class="font-medium text-brand-dark">Üst Notalar:</strong> ${product.topNotes.join(', ')}</div>
                        <div class="text-xs"><strong class="font-medium text-brand-dark">Kalp Notalar:</strong> ${product.heartNotes.join(', ')}</div>
                        <div class="text-xs"><strong class="font-medium text-brand-dark">Dip Notalar:</strong> ${product.baseNotes.join(', ')}</div>
                    </div>

                    <div class="pt-4 border-t border-brand-green/10 flex items-center justify-between">
                        <div class="font-serif text-2xl font-bold text-brand-dark">${product.price.toLocaleString('tr-TR')} TL</div>
                        <button onclick="addToCart('${product.id}'); closeQuickView();" class="px-6 py-3 bg-brand-green text-white text-xs uppercase tracking-widest rounded-full hover:bg-brand-green-dark transition-colors">
                            Sepete Ekle
                        </button>
                    </div>
                </div>
            `;

            const modal = document.getElementById('quickViewModal');
            const content = document.getElementById('quickViewContent');
            modal.classList.remove('opacity-0', 'pointer-events-none');
            content.classList.remove('scale-95');
            content.classList.add('scale-100');
        }

        function closeQuickView() {
            const modal = document.getElementById('quickViewModal');
            const content = document.getElementById('quickViewContent');
            modal.classList.add('opacity-0', 'pointer-events-none');
            content.classList.remove('scale-100');
            content.classList.add('scale-95');
        }

        // --- SEARCH FUNCTIONALITY ---
        function handleSearch() {
            const query = document.getElementById('searchInput').value.toLowerCase().trim();
            const resultsContainer = document.getElementById('searchResults');

            if (!query) {
                resultsContainer.innerHTML = `<p class="text-xs text-brand-muted text-center py-4">Aramak istediğiniz terimi yazmaya başlayın.</p>`;
                return;
            }

            const matched = products.filter(p => 
                p.name.toLowerCase().includes(query) || 
                p.topNotes.some(n => n.toLowerCase().includes(query)) ||
                p.heartNotes.some(n => n.toLowerCase().includes(query)) ||
                p.baseNotes.some(n => n.toLowerCase().includes(query))
            );

            if (matched.length === 0) {
                resultsContainer.innerHTML = `<p class="text-xs text-brand-muted text-center py-4">Eşleşen ürün bulunamadı.</p>`;
                return;
            }

            resultsContainer.innerHTML = matched.map(p => `
                <div onclick="openQuickView('${p.id}'); closeSearch();" class="flex items-center justify-between p-3 bg-white rounded-xl hover:bg-brand-bg-alt cursor-pointer transition-colors border border-brand-green/5">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-brand-green/10 flex items-center justify-center text-brand-green font-serif font-bold text-xs">
                            AB
                        </div>
                        <div>
                            <h4 class="font-serif text-sm font-medium text-brand-dark">${p.name}</h4>
                            <span class="text-[10px] text-brand-muted">${p.volume}</span>
                        </div>
                    </div>
                    <span class="font-serif text-xs font-semibold text-brand-dark">${p.price.toLocaleString('tr-TR')} TL</span>
                </div>
            `).join('');
        }

        // --- DRAWER & MODAL TOGGLES ---
        function openCart() {
            const drawer = document.getElementById('cartDrawer');
            const content = document.getElementById('cartDrawerContent');
            drawer.classList.remove('opacity-0', 'pointer-events-none');
            content.classList.remove('translate-x-full');
        }

        function closeCart() {
            const drawer = document.getElementById('cartDrawer');
            const content = document.getElementById('cartDrawerContent');
            drawer.classList.add('opacity-0', 'pointer-events-none');
            content.classList.add('translate-x-full');
        }

        function openMobileMenu() {
            const drawer = document.getElementById('mobileDrawer');
            const content = document.getElementById('mobileDrawerContent');
            drawer.classList.remove('opacity-0', 'pointer-events-none');
            content.classList.remove('-translate-x-full');
        }

        function closeMobileMenu() {
            const drawer = document.getElementById('mobileDrawer');
            const content = document.getElementById('mobileDrawerContent');
            drawer.classList.add('opacity-0', 'pointer-events-none');
            content.classList.add('-translate-x-full');
        }

        function openSearch() {
            const modal = document.getElementById('searchModal');
            modal.classList.remove('opacity-0', 'pointer-events-none');
            document.getElementById('searchInput').focus();
        }

        function closeSearch() {
            const modal = document.getElementById('searchModal');
            modal.classList.add('opacity-0', 'pointer-events-none');
        }

        // --- TOAST NOTIFICATIONS ---
        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMessage').textContent = message;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        function handleCheckout() {
            if (cart.length === 0) {
                showToast("Sepetiniz boş!");
                return;
            }
            showToast("Sipariş ekranına yönlendiriliyorsunuz...");
        }

        function handleNewsletterSubmit(e) {
            e.preventDefault();
            showToast("Aromabar bültenine başarıyla kaydoldunuz.");
            e.target.reset();
        }

        // --- EVENT LISTENERS SETUP ---
        function setupEventListeners() {
            document.getElementById('cartOpenBtn').addEventListener('click', openCart);
            document.getElementById('cartCloseBtn').addEventListener('click', closeCart);
            document.getElementById('mobileMenuBtn').addEventListener('click', openMobileMenu);
            document.getElementById('mobileMenuCloseBtn').addEventListener('click', closeMobileMenu);
            document.getElementById('quickViewCloseBtn').addEventListener('click', closeQuickView);
            document.getElementById('searchOpenBtn').addEventListener('click', openSearch);
            document.getElementById('searchCloseBtn').addEventListener('click', closeSearch);

            // Close mobile menu when clicking nav links
            document.querySelectorAll('.mobile-nav-link').forEach(link => {
                link.addEventListener('click', closeMobileMenu);
            });
        }
    </script>
</body>
</html>
