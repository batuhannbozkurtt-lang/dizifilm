    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            green: '#5B8265',
                            'green-dark': '#43614B',
                            'green-light': '#78A183',
                            gold: '#DEC565',
                            'gold-dark': '#B89F43',
                            'gold-light': '#F5EA9F',
                            bg: '#FDFBF7',
                            'bg-alt': '#F5F2EB',
                            dark: '#2A302C',
                            muted: '#616963',
                            card: '#FFFFFF'
                        }
                    },
                    fontFamily: {
                        serif: ['Cormorant Garamond', 'serif'],
                        sans: ['Montserrat', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #FDFBF7;
            color: #2A302C;
            font-family: 'Montserrat', sans-serif;
            overflow-x: hidden;
        }
        h1, h2, h3, h4, h5, .font-serif-custom {
            font-family: 'Cormorant Garamond', serif;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #F5F2EB;
        }
        ::-webkit-scrollbar-thumb {
            background: #5B8265;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #43614B;
        }
        /* Gold Shimmer Text Effect */
        .gold-gradient-text {
            background: linear-gradient(135deg, #DEC565 0%, #B89F43 50%, #F5EA9F 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        /* Glassmorphism */
        .glass-panel {
            background: rgba(253, 251, 247, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
    </style>
</head>
<body class="antialiased selection:bg-brand-gold selection:text-brand-dark">

    <!-- TOP ANNOUNCEMENT BAR -->
    <div class="bg-brand-dark text-brand-gold-light text-xs font-light py-2 text-center tracking-widest uppercase border-b border-brand-gold/20">
        <span class="inline-block animate-pulse mr-2">✦</span> Tüm Siparişlerde Özel Lüks Hediye Kutusu ve Ücretsiz Kargo <span class="inline-block animate-pulse ml-2">✦</span>
    </div>

    <!-- NAVIGATION BAR -->
    <header class="sticky top-0 z-40 glass-panel border-b border-brand-green/10 transition-all duration-300" id="mainHeader">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Mobile Menu Toggle Button -->
            <button id="mobileMenuBtn" class="lg:hidden text-brand-dark hover:text-brand-green p-2 text-xl transition-colors">
                <i class="fa-solid fa-bars-staggered"></i>
            </button>

            <!-- Brand Logo -->
            <a href="#" class="flex flex-col items-center group">
                <span class="font-serif text-2xl sm:text-3xl font-bold tracking-[0.25em] text-brand-dark group-hover:text-brand-green transition-colors">AROMABAR</span>
                <span class="text-[9px] tracking-[0.35em] text-brand-gold uppercase -mt-1 font-semibold">Haute Parfumerie</span>
            </a>

            <!-- Desktop Navigation Links -->
            <nav class="hidden lg:flex items-center space-x-8 text-xs uppercase tracking-widest font-medium text-brand-dark/80">
                <a href="#koleksiyon" class="hover:text-brand-green transition-colors py-2 border-b-2 border-transparent hover:border-brand-gold">Koleksiyon</a>
                <a href="#koku-testi" class="hover:text-brand-green transition-colors py-2 border-b-2 border-transparent hover:border-brand-gold flex items-center gap-1.5 text-brand-green font-semibold">
                    <i class="fa-solid fa-wand-magic-sparkles text-brand-gold"></i> Parfüm Testi
                </a>
                <a href="#notalar" class="hover:text-brand-green transition-colors py-2 border-b-2 border-transparent hover:border-brand-gold">Notalar Keşfi</a>
                <a href="#hikayemiz" class="hover:text-brand-green transition-colors py-2 border-b-2 border-transparent hover:border-brand-gold">Hakkımızda</a>
                <a href="#iletisim" class="hover:text-brand-green transition-colors py-2 border-b-2 border-transparent hover:border-brand-gold">İletişim</a>
            </nav>

            <!-- Utility Icons -->
            <div class="flex items-center space-x-5 text-brand-dark">
                <!-- Search Button -->
                <button id="searchOpenBtn" class="p-2 hover:text-brand-green transition-colors">
                    <i class="fa-solid fa-magnifying-glass text-lg"></i>
                </button>
                
                <!-- Shopping Cart Button -->
                <button id="cartOpenBtn" class="p-2 hover:text-brand-green transition-colors relative">
                    <i class="fa-solid fa-bag-shopping text-xl"></i>
                    <span id="cartBadge" class="absolute -top-1 -right-1 bg-brand-gold text-brand-dark font-bold text-[10px] w-5 h-5 rounded-full flex items-center justify-center border-2 border-white transform scale-0 transition-transform duration-300">0</span>
